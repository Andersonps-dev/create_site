# Dados do negócio usados no HTML como %VITE_*%. Copie para .env e preencha.
# Endereço final do site (sem barra no fim). Usado em canonical, Open Graph, sitemap e llms.txt.
VITE_SITE_URL=PREENCHER

# Marca como aparece no logo e slogan curto (header, títulos)
VITE_MARCA=PREENCHER
VITE_SLOGAN=PREENCHER

# Identificação do controlador (LGPD) — conforme cadastro na Receita Federal.
VITE_NOME_FANTASIA=PREENCHER
VITE_RAZAO_SOCIAL=PREENCHER
VITE_CNPJ=PREENCHER
VITE_EMAIL=PREENCHER

# Contato (igual ao Perfil da Empresa no Google)
VITE_TELEFONE=PREENCHER
VITE_WHATSAPP=55DDDNUMERO
VITE_ENDERECO=PREENCHER
